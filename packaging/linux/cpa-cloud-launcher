#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${APPDIR:-}" ]]; then
  resource_root="$APPDIR/usr/lib/cpa-cloud"
else
  resource_root="/usr/lib/cpa-cloud"
fi

server="$resource_root/cpa-cloud"
web_root="$resource_root/web"
data_root="${XDG_CONFIG_HOME:-$HOME/.config}/cpa-cloud"
url="http://127.0.0.1:8787/admin/"

fail() {
  printf 'CPA Cloud: %s\n' "$*" >&2
  exit 1
}

# AppImage files are often launched directly from a file manager, where stdin
# is not attached to a terminal. Re-enter through a terminal so the first-run
# password prompt and process lifetime remain visible to the user.
if [[ ! -t 0 && "${CPA_CLOUD_TERMINAL_HOSTED:-}" != "1" ]]; then
  export CPA_CLOUD_TERMINAL_HOSTED=1
  if command -v x-terminal-emulator >/dev/null 2>&1; then
    exec x-terminal-emulator -e env CPA_CLOUD_TERMINAL_HOSTED=1 "$0"
  elif command -v gnome-terminal >/dev/null 2>&1; then
    exec gnome-terminal -- env CPA_CLOUD_TERMINAL_HOSTED=1 "$0"
  elif command -v konsole >/dev/null 2>&1; then
    exec konsole -e env CPA_CLOUD_TERMINAL_HOSTED=1 "$0"
  elif command -v xterm >/dev/null 2>&1; then
    exec xterm -e env CPA_CLOUD_TERMINAL_HOSTED=1 "$0"
  fi
  fail "no terminal emulator is available; run this package from a terminal."
fi

[[ -x "$server" ]] || fail "server executable is missing: $server"
[[ -f "$web_root/index.html" ]] || fail "web console is missing: $web_root/index.html"
command -v flock >/dev/null 2>&1 || fail "flock is required (normally provided by util-linux)."
command -v curl >/dev/null 2>&1 || fail "curl is required to verify the owned service instance."

umask 077
mkdir -p "$data_root"
chmod 700 "$data_root"
exec 9>"$data_root/.launcher.lock"
if ! flock -n 9; then
  fail "another CPA Cloud launcher instance is already running; no browser was opened because this process cannot verify that instance."
fi

set +e
"$server" --data-dir "$data_root" --check-initialized >/dev/null 2>&1
initialized_status=$?
set -e
if [[ $initialized_status -eq 3 ]]; then
  printf 'CPA Cloud first-run setup\n'
  printf 'Create the administrator password (12-72 UTF-8 bytes).\n'
  IFS= read -r -s -p 'Password: ' password
  printf '\n'
  IFS= read -r -s -p 'Confirm password: ' confirmation
  printf '\n'
  [[ "$password" == "$confirmation" ]] || fail "passwords do not match."
  password_bytes=$(printf '%s' "$password" | wc -c | tr -d ' ')
  [[ $password_bytes -ge 12 && $password_bytes -le 72 ]] || fail "password must be 12-72 UTF-8 bytes."
  printf '%s\n' "$password" | "$server" --data-dir "$data_root" --init
  unset password confirmation
elif [[ $initialized_status -ne 0 ]]; then
  fail "could not inspect the data directory."
fi

instance_id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || true)
[[ "$instance_id" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "could not create a service instance identifier."
log_file="$data_root/server.log"
"$server" \
  --data-dir "$data_root" \
  --listen 127.0.0.1:8787 \
  --web-dir "$web_root" \
  --instance-id "$instance_id" \
  >"$log_file" 2>&1 &
server_pid=$!

cleanup() {
  if kill -0 "$server_pid" >/dev/null 2>&1; then
    kill -TERM "$server_pid" >/dev/null 2>&1 || true
    wait "$server_pid" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT INT TERM

ready=0
for ((attempt = 0; attempt < 100; attempt++)); do
  if ! kill -0 "$server_pid" >/dev/null 2>&1; then
    break
  fi
  health=$(curl --fail --silent --show-error --max-time 1 http://127.0.0.1:8787/healthz 2>/dev/null || true)
  if [[ "$health" == *"\"instance_id\":\"$instance_id\""* && "$health" == *'"status":"ok"'* ]]; then
    ready=1
    break
  fi
  sleep 0.1
done

if [[ $ready -ne 1 ]]; then
  tail -n 20 "$log_file" >&2 || true
  fail "service did not become ready."
fi

printf 'CPA Cloud is running at %s\n' "$url"
printf 'Close this terminal or press Ctrl+C to stop it.\n'
if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$url" >/dev/null 2>&1 || printf 'Open %s in a browser.\n' "$url"
else
  printf 'Open %s in a browser.\n' "$url"
fi

set +e
wait "$server_pid"
status=$?
set -e
trap - EXIT INT TERM
exit "$status"
